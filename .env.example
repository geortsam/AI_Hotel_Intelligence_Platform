# ---------------------------------------------------------------------------
# AI Hotel Intelligence Platform - environment template.
# Copy to .env and fill in real values. NEVER commit the resulting .env.
#
# This file has TWO readers, and it is worth knowing which is which:
#
#   Docker Compose   reads .env from the repository root to expand ${...} in
#                    docker-compose.yml, and passes a named subset into the containers.
#   pydantic-settings reads .env from the working directory when you run the backend
#                    directly (app/core/config.py, `env_file=".env"`).
#
# So a variable can matter to the compose stack, to a direct local run, or to both. Each
# section below says which.
#
# TWO values must be set before `docker compose up --build` does anything useful:
#
#   POSTGRES_PASSWORD   always. Compose refuses to start without it.
#   SECRET_KEY          for ENVIRONMENT=production. The API refuses to start without it,
#                       and so does the migration step.
#
# Nothing here carries a real credential, and no example secret below is usable: generate
# your own. Do not paste a value into this file -- put it in .env, which .gitignore blocks.
# ---------------------------------------------------------------------------


# --- Application -----------------------------------------------------------
# One of: development | test | staging | production.   [compose + local]
#
# Interactive API docs (/docs, /redoc, /openapi.json) are served in every mode EXCEPT
# production, where they are switched off automatically.
#
# ENVIRONMENT=production additionally makes SECRET_KEY mandatory: app/core/config.py refuses
# to construct a production configuration without one rather than falling back to a built-in
# value. That refusal happens at import, so the api container exits immediately and -- because
# it has `restart: unless-stopped` -- keeps retrying. If the API will not come up in
# production, this is the first thing to check:
#
#   docker compose logs api
#
# The migration service checks it too, and sooner: database/migrations/env.py constructs the
# same Settings object, so a production stack with no SECRET_KEY fails at `migrate` before a
# single revision is applied.
ENVIRONMENT=development
DEBUG=false
APP_NAME=AI Hotel Intelligence Platform
API_V1_PREFIX=/api/v1


# --- Observability ---------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL            [compose + local]
LOG_LEVEL=INFO


# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins.     [compose + local]
#
# Relevant to a direct local run, where the Vite dev server is a different origin from the
# API. It is NOT used by the compose stack: there, nginx proxies /api/ to the api service on
# the browser's own origin, so requests are same-origin and no CORS preflight ever happens.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# --- Database --------------------------------------------------------------
#
# In the COMPOSE stack you set POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB and Compose
# assembles DATABASE_URL itself, pointing at `db:5432` on the internal network. Both the api
# and the migrate service receive the identical URL -- deliberately, so the schema that is
# upgraded is the schema that is served. Leave DATABASE_URL, POSTGRES_HOST and POSTGRES_PORT
# alone unless you are running the backend directly.
#
# POSTGRES_PASSWORD IS REQUIRED. There is no default and none will be invented:
# docker-compose.yml guards it with `${POSTGRES_PASSWORD:?...}`, so Compose stops before
# creating anything. Choose a strong value; it is the only real secret the data tier has.
#
# PostgreSQL IS NO LONGER PUBLISHED TO THE HOST. The `db` service has no `ports:` entry, so
# 5432 is reachable from the api and migrate containers and from nowhere else -- not from the
# host, not from the network. Nothing on the host needs it, and publishing it exposed the
# password to every process on the machine. To inspect the database, go through the container:
#
#   docker compose exec db psql -U "$POSTGRES_USER" -d "$POSTGRES_DB"
#
# POSTGRES_HOST and POSTGRES_PORT below are for a DIRECT local run only (they build a URL via
# app/core/config.py when DATABASE_URL is empty). Compose ignores both.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hotel
POSTGRES_PASSWORD=
POSTGRES_DB=hotel_intelligence


# --- Security --------------------------------------------------------------
# HMAC key that signs and verifies JWT access tokens.  [compose + local]
#
# REQUIRED IN PRODUCTION, and strongly recommended everywhere else: without it the API starts
# in development but every token operation raises, so sign-in does not work. Generate one:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Left empty here on purpose. A value committed to a template is a value that ends up in real
# deployments, and a shared signing key is a forgeable token for every one of them.
SECRET_KEY=


# --- Trusted proxies -------------------------------------------------------
# Comma-separated IP addresses or CIDR blocks of reverse proxies whose forwarding headers
# (X-Forwarded-For, X-Forwarded-Proto) may be believed.          [compose + local]
#
# EMPTY IS THE SAFE DEFAULT: while this is empty no forwarding header is read at all, so no
# client can choose its own rate-limit identity. Nothing is implicitly trusted -- not
# 127.0.0.1, not any private range.
#
# EMPTY IS ALSO THE WRONG VALUE FOR THE COMPOSE STACK, and this is the one setting here that
# needs a deliberate decision rather than a default. nginx sits in front of the API, so with
# this empty the backend attributes every request to the frontend container instead of to the
# client. Two consequences, both real:
#
#   * rate limiting keys on that single address, so the login limit of 5 requests per 60
#     seconds becomes ONE bucket shared by every user of the deployment;
#   * audit events record the proxy's address rather than the client's.
#
# Set it to the network the frontend container connects from. Compose allocates that subnet at
# runtime, which is exactly why no value is hard-coded here -- read yours back with:
#
#   docker network inspect <project>_default --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
#
# then set, for example:
#
#   TRUSTED_PROXIES=172.18.0.0/16
#
# Set this ONLY to addresses your own proxy connects from, and keep it as narrow as you can:
# any peer inside the range can claim to be any client. NEVER write 0.0.0.0/0 or ::/0 -- that
# trusts the entire internet and hands every client control of its own identity, which is
# worse than leaving this empty.
TRUSTED_PROXIES=


# --- HSTS ------------------------------------------------------------------
# Sent only when ENVIRONMENT=production AND the original client used HTTPS, so a developer's
# browser is never told to refuse http://localhost.   [compose passes none of these; local]
#
# Note that "the original client used HTTPS" is read from X-Forwarded-Proto under the same
# trust rule as the address above, so HSTS stays silent until TRUSTED_PROXIES is set. The
# compose stack terminates no TLS -- nginx listens on port 80 -- so these matter once
# something upstream does.
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
# Preloading is close to irreversible -- removal takes months to reach users -- so it is
# off unless a deployment turns it on deliberately.
HSTS_PRELOAD=false


# --- Host ports (docker compose only) --------------------------------------
#
# Which host port each published service binds. These are host-side only: Compose reads them
# and no container ever sees them.
#
# API_PORT reaches the API directly, bypassing nginx. It is kept published for now because it
# is how a first bring-up gets debugged, and it is where /docs lives while ENVIRONMENT is not
# production. A hardened deployment should stop publishing it.
#
# FRONTEND_PORT is the one a browser should use: http://localhost:5173 serves the built SPA,
# and nginx proxies its /api/ calls to the api service on the same origin. That is also why
# the frontend needs no API URL of its own -- VITE_API_BASE_URL is built in empty (see
# docker-compose.yml and frontend/.env.example), which means "same origin as the page". Give
# it a value only if you deliberately move the API to a different origin, and then you must
# also widen the `connect-src` CSP in frontend/nginx.conf and set CORS_ORIGINS above.
#
# There is no POSTGRES_PORT here any more: the database is not published to the host.
API_PORT=8000
FRONTEND_PORT=5173
