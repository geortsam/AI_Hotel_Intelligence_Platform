# ---------------------------------------------------------------------------
# AI Hotel Intelligence Platform - environment template.
# Copy to .env and fill in real values. NEVER commit the resulting .env.
#
# Stage 1: every value below has a working default, so the backend starts with no .env at
# all. Variables marked [later stage] are declared for the topology but are not read by any
# code yet.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# One of: development | test | staging | production.
# Interactive API docs are disabled automatically in production.
ENVIRONMENT=development
DEBUG=false
APP_NAME=AI Hotel Intelligence Platform
API_V1_PREFIX=/api/v1

# --- Observability ---------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins (the Vite dev server, etc.).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database [later stage] ------------------------------------------------
# Either set DATABASE_URL directly, or leave it empty and use the parts below.
# Docker Compose builds DATABASE_URL for the api service automatically.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hotel
POSTGRES_PASSWORD=
POSTGRES_DB=hotel_intelligence

# --- Security [later stage] ------------------------------------------------
# HMAC key that will sign JWTs once authentication exists. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# There is no authentication in Stage 1, so this may stay empty for now.
SECRET_KEY=

# --- Trusted proxies (Stage 4.5.6) -----------------------------------------
# Comma-separated IP addresses or CIDR blocks of reverse proxies whose forwarding headers
# (X-Forwarded-For, X-Forwarded-Proto) may be believed.
#
# EMPTY IS THE SAFE DEFAULT and is correct for a direct deployment: while this is empty no
# forwarding header is read at all, so no client can choose its own rate-limit identity.
# Nothing is implicitly trusted -- not 127.0.0.1, not any private range.
#
# Set this ONLY to the addresses your own proxy connects from. Setting it too broadly is the
# whole vulnerability: any peer inside the range can then claim to be any client.
#   TRUSTED_PROXIES=10.0.0.0/8,192.168.1.5
TRUSTED_PROXIES=

# --- HSTS (Stage 4.5.6) ----------------------------------------------------
# Sent only when ENVIRONMENT=production AND the original client used HTTPS, so a developer's
# browser is never told to refuse http://localhost.
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
# Preloading is close to irreversible -- removal takes months to reach users -- so it is
# off unless a deployment turns it on deliberately.
HSTS_PRELOAD=false

# --- Local ports (docker compose) ------------------------------------------
API_PORT=8000
FRONTEND_PORT=5173
