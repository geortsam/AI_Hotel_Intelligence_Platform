# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
ENV/
.Python

# --- Testing / tooling caches ---------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# --- Secrets (NEVER commit) ------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# The rest of what a CA hands out, and the directory the TLS runbook creates.
# docs/deployment/tls.md defaults TLS_CERT_DIR to ./certs, so following it puts certificate
# material inside this repository; *.pem and *.key alone do not cover a .crt/.pfx bundle.
certs/
*.crt
*.cer
*.pfx
*.p12
*.jks

# --- Databases -------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# Dumps. docs/deployment/backup-restore.md writes `hotel-intelligence-<stamp>.backup` into the
# repository root, so the one file most worth never committing lands where `git add -A` sees it.
*.backup
*.dump

# --- Data: payloads are ignored, documentation and manifests are tracked ---
ml/data/raw/*
ml/data/processed/*
ml/data/external/*
!ml/data/**/.gitkeep
!ml/data/**/README.md

# One exception, added in Stage 6.3. The processed demand dataset is 263 KB of text whose
# sha256 is pinned in a COMMITTED manifest, and the offline evaluation has to be able to run in
# CI -- which cannot download 17 MB of raw source and must not be allowed to skip instead. A
# payload whose checksum is committed beside it is verifiable rather than merely present.
!ml/data/processed/demand_daily_v1.csv

# --- Trained model artifacts ----------------------------------------------
# Weights are large binaries and are never committed. Evaluation records are, so a metric
# can always be traced back to a real run.
# Written file by file rather than as `ml/models/**`, because git does not descend into an
# excluded DIRECTORY and a negation beneath one therefore never fires. Stage 6.3 is the first
# stage to produce a metrics.json, and with the old spelling it would have been ignored --
# silently, which is the worst way for a rule stating "evaluation records are committed" to
# fail.
ml/models/*
!ml/models/.gitkeep
!ml/models/*/
ml/models/*/*
# Three names, each a deliberate decision rather than a blanket `*.json`: the metric of record
# (Stage 6.3), the robustness analysis and the registry entry (Stage 6.4). Weights, pickles and
# any other payload stay ignored, which is what keeps "no serving artifact" structural.
!ml/models/*/metrics.json
!ml/models/*/validation.json
!ml/models/*/registry.json
# Stage 6.5. The fitted payload (model.pkl) is NOT here and must not be: the rule above says
# weights are never committed, and a pickle is arbitrary code on load. artifact.json carries the
# checksums that make a regenerated payload verifiable.
!ml/models/*/artifact.json

# --- Node / frontend -------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# --- Notebooks -------------------------------------------------------------
.ipynb_checkpoints/

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
