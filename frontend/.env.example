# Frontend environment template. Copy to .env.local for local development.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle, and everything that
# is exposed is readable by anyone who opens devtools. Never put a secret here.

# Origin of the backend API, e.g. https://api.example.com -- no trailing slash, and no
# /api/v1 suffix (the client adds the prefix).
#
# Leave EMPTY for local development: requests then go to the dev server's own origin and
# the proxy in vite.config.ts forwards /api to the backend, so the browser stays
# same-origin and no CORS preflight is involved.
VITE_API_BASE_URL=

# Where that dev-server proxy forwards to. Read by vite.config.ts in Node, NOT exposed to
# the bundle, and ignored by a production build. Defaults to http://localhost:8000.
VITE_API_PROXY_TARGET=
